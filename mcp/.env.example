# Server-only configuration for the local AGym MCP process.
# Copy to mcp/.env.local or supply through Hermes mcp_servers.env.
# Never place the service-role key in Vite/browser environment files or Git.
AGYM_SUPABASE_URL=https://your-project-ref.supabase.co
AGYM_SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
AGYM_USER_ID=your-supabase-auth-user-uuid
AGYM_AGENT_IDENTIFIER=hermes
